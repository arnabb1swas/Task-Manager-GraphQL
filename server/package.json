    "dotenv": "^17.0.0",
    "express": "^5.1.0",
    "graphql": "^16.9.0",
    "graphql-middleware": "^6.1.35",
    "graphql-shield": "^7.6.5",
    "graphql-tag": "^2.12.6",
    "@graphql-tools/schema": "^10.0.0",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
